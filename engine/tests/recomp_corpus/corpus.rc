// Resources of the R4 corpus exe (`mod_corpus.c` `t_mod_resources`): a numbered resource of a
// custom type (like v1.1.5.6's type 256, IDs 104-106), a named RCDATA, and one name in two languages.
// Compiled with llvm-rc (CI) or `zig rc` and linked into corpus.exe by lld-link.

LANGUAGE 0x09, 0x01
104 256 { "WSE2corpus" }
WSE_NAMED RCDATA { "named" }

LANGUAGE 0x07, 0x01
200 RCDATA { "de" }

LANGUAGE 0x09, 0x01
200 RCDATA { "en" }
