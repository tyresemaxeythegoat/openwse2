<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="false" />

    <!-- The R4 startup run in the background (R4ForegroundService): a foreground service with a
         progress notification, a CPU wake lock, and the result notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name=".WseLauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WseActivity"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask" />
        <!-- Vulkan driver probe runs isolated: a crashing user driver kills only this process. -->
        <service
            android:name=".WseVulkanProbeService"
            android:exported="false"
            android:process=":vkprobe" />
        <!-- Phase 5 R4 startup run: maps the translated game at fixed addresses and ends its
             process when done, so it runs isolated from the launcher. -->
        <service
            android:name=".R4StartupService"
            android:exported="false"
            android:process=":recomp" />
        <!-- Keeps the launcher process (which holds the binding to :recomp) running while the R4
             startup run goes on in the background. -->
        <service
            android:name=".R4ForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Ahead-of-time translation and a test run of the user's game, started by the user, with progress and a Stop button" />
        </service>
    </application>

</manifest>
