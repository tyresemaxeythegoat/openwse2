<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/wse_ripple_light">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/wse_control_corner_radius" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true" android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/wse_bg_row_selected_pressed" />
                    <corners android:radius="@dimen/wse_control_corner_radius" />
                    <stroke
                        android:width="@dimen/wse_stroke_selected_width"
                        android:color="@color/wse_accent" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/wse_bg_row_selected" />
                    <corners android:radius="@dimen/wse_control_corner_radius" />
                    <stroke
                        android:width="@dimen/wse_stroke_selected_width"
                        android:color="@color/wse_accent" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/wse_bg_row_pressed" />
                    <corners android:radius="@dimen/wse_control_corner_radius" />
                    <stroke
                        android:width="@dimen/wse_stroke_width"
                        android:color="@color/wse_border" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/wse_bg_row_normal" />
                    <corners android:radius="@dimen/wse_control_corner_radius" />
                    <stroke
                        android:width="@dimen/wse_stroke_width"
                        android:color="@color/wse_border" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
