<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/wse_ripple_light">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/wse_control_corner_radius" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <selector>
                    <item android:state_enabled="false">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/wse_bg_secondary_disabled" />
                            <corners android:radius="@dimen/wse_control_corner_radius" />
                            <stroke
                                android:width="@dimen/wse_stroke_width"
                                android:color="@color/wse_border_disabled" />
                        </shape>
                    </item>
                    <item android:state_pressed="true">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/wse_bg_row_pressed" />
                            <corners android:radius="@dimen/wse_control_corner_radius" />
                            <stroke
                                android:width="@dimen/wse_stroke_width"
                                android:color="@color/wse_accent" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="@color/wse_bg_row_normal" />
                            <corners android:radius="@dimen/wse_control_corner_radius" />
                            <stroke
                                android:width="@dimen/wse_stroke_width"
                                android:color="@color/wse_border" />
                        </shape>
                    </item>
                </selector>
            </item>
            <item
                android:width="@dimen/wse_spinner_arrow_size"
                android:height="@dimen/wse_spinner_arrow_size"
                android:drawable="@drawable/wse_ic_arrow_drop_down"
                android:end="@dimen/wse_spinner_arrow_inset"
                android:gravity="center_vertical|end" />
        </layer-list>
    </item>
</ripple>
