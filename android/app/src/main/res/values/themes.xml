<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Wse2.Launcher" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/wse_bg_window</item>
        <item name="android:colorBackground">@color/wse_bg_window</item>
        <item name="android:colorBackgroundFloating">@color/wse_bg_card</item>
        <item name="android:colorPrimary">@color/wse_accent</item>
        <item name="android:colorPrimaryDark">@color/wse_bg_window</item>
        <item name="android:colorAccent">@color/wse_accent</item>
        <item name="android:colorControlNormal">@color/wse_text_secondary</item>
        <item name="android:colorControlActivated">@color/wse_accent</item>
        <item name="android:colorControlHighlight">@color/wse_ripple_light</item>
        <item name="android:textColorPrimary">@color/wse_text_primary</item>
        <item name="android:textColorSecondary">@color/wse_text_secondary</item>
        <item name="android:textColorTertiary">@color/wse_text_secondary</item>
        <item name="android:textColorHint">@color/wse_text_disabled</item>
        <item name="android:statusBarColor">@color/wse_bg_window</item>
        <item name="android:navigationBarColor">@color/wse_bg_window</item>
        <item name="android:navigationBarDividerColor">@color/wse_border</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.Wse2.Launcher.Dialog</item>
        <item name="android:dialogTheme">@style/Theme.Wse2.Launcher.Dialog</item>
        <item name="android:scrollbarThumbVertical">@drawable/wse_scrollbar_thumb</item>
    </style>

    <style name="Theme.Wse2.Launcher.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/wse_bg_card</item>
        <item name="android:colorBackgroundFloating">@color/wse_bg_card</item>
        <item name="android:colorAccent">@color/wse_accent</item>
        <item name="android:colorControlNormal">@color/wse_text_secondary</item>
        <item name="android:colorControlActivated">@color/wse_accent</item>
        <item name="android:colorControlHighlight">@color/wse_ripple_light</item>
        <item name="android:textColorPrimary">@color/wse_text_primary</item>
        <item name="android:textColorSecondary">@color/wse_text_secondary</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.Wse2.DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.Wse2.DialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/Widget.Wse2.DialogButton</item>
    </style>

    <style name="Widget.Wse2.DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/wse_accent</item>
        <item name="android:minHeight">@dimen/wse_min_touch_target</item>
    </style>
</resources>
